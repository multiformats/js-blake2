{
  "name": "@multiformats/blake2",
  "version": "2.0.3",
  "description": "Multiformats BLAKE2 implementations",
  "author": "Rod Vagg <r@va.gg>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/multiformats/js-blake2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiformats/js-blake2.git"
  },
  "bugs": {
    "url": "https://github.com/multiformats/js-blake2/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "blake2",
    "hash",
    "ipfs",
    "ipld",
    "multiformats",
    "multihash"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "*",
        "dist/*",
        "dist/src/*",
        "dist/src/*/index"
      ],
      "src/*": [
        "*",
        "dist/*",
        "dist/src/*",
        "dist/src/*/index"
      ]
    }
  },
  "files": [
    "src",
    "dist",
    "!dist/test",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "module-sync": "./dist/src/index.js"
    },
    "./blake2b": {
      "types": "./dist/src/blake2b.d.ts",
      "import": "./dist/src/blake2b.js",
      "module-sync": "./dist/src/blake2b.js"
    },
    "./blake2s": {
      "types": "./dist/src/blake2s.d.ts",
      "import": "./dist/src/blake2s.js",
      "module-sync": "./dist/src/blake2s.js"
    }
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "breaking": true,
              "release": "major"
            },
            {
              "revert": true,
              "release": "patch"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "type": "deps",
              "release": "patch"
            },
            {
              "scope": "no-release",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "chore",
                "section": "Trivial Changes"
              },
              {
                "type": "docs",
                "section": "Documentation"
              },
              {
                "type": "deps",
                "section": "Dependencies"
              },
              {
                "type": "test",
                "section": "Tests"
              }
            ]
          }
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ]
        }
      ]
    ]
  },
  "scripts": {
    "clean": "aegir clean",
    "lint": "aegir lint",
    "build": "aegir build",
    "release": "aegir release",
    "docs": "aegir docs",
    "test": "aegir test",
    "test:node": "aegir test -t node --cov",
    "test:chrome": "aegir test -t browser --cov",
    "test:chrome-webworker": "aegir test -t webworker",
    "test:firefox": "aegir test -t browser -- --browser firefox",
    "test:firefox-webworker": "aegir test -t webworker -- --browser firefox",
    "test:electron-main": "aegir test -t electron-main",
    "dep-check": "aegir dep-check"
  },
  "dependencies": {
    "blakejs": "^1.2.1",
    "multiformats": "^14.0.3"
  },
  "devDependencies": {
    "aegir": "^48.1.1"
  }
}
